# Google Sheets auto-submit
# Paste your Apps Script Web App URL here, then rename this file to .env
VITE_SHEETS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Deepgram (voice-answer transcription, api/deepgram-token.js)
# Server-side only -- deliberately NOT prefixed with VITE_, so Vite never
# bundles it into client code. This var in a local .env file only affects
# `vercel dev`; for the deployed app it must be set in the Vercel project's
# dashboard (Settings -> Environment Variables), not committed here.
DEEPGRAM_API_KEY=your_deepgram_api_key
